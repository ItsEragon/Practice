<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>airbnb | Home</title>
    <!-- <link rel="stylesheet" href="home.css" /> -->
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body class="flex items-center justify-center flex-col">
    <header class="mt-10 px-20 py-6 rounded-xl shadow-lg">
      <h1 class="text-4xl font-semibold text-green-700 text-center">
        Here are our registered homes:
      </h1>

      <ul>
        <% registeredHomes.forEach(home => { %>
          <li>
            <%= home.houseName %>
          </li>

        <% }) %>
      </ul>
    </header>
    <main class="mt-10 text-center">
      <a
        class="border rounded-xl px-4 py-0.5 bg-orange-600 text-white text-2xl"
        href="/host/add-home"
        >Add Home</a
      >
    </main>
  </body>
</html>
